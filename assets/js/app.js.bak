const API_CONFIG={url:"https://dbtvicvsabdypxjhafxt.supabase.co",anonKey:"sb_publishable_cE_nDKgQJMBczIgGph0WbA_ekFMWxlq"};
const labels={men:"رجال",women:"نساء",unisex:"للجنسين",original:"أورجينال"};
let products=[],cart=JSON.parse(localStorage.getItem("wissam_cart")||"[]"),current=null,currentSize=null,qty=1;
const money=n=>Number(n||0).toLocaleString("ar-EG",{maximumFractionDigits:2})+" جنيه";
const esc=s=>String(s??"").replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[m]));
function fp(s){let p=Number(s?.price||0);if(!s?.discount_enabled)return p;let d=Number(s.discount_value||0);return s.discount_type==="percent"?Math.max(0,p-p*d/100):Math.max(0,p-d)}
const headers={apikey:API_CONFIG.anonKey,Authorization:`Bearer ${API_CONFIG.anonKey}`};
async function loadSettings(){try{let r=await fetch(`${API_CONFIG.url}/rest/v1/settings?select=*&limit=1`,{headers});if(!r.ok)throw Error(await r.text());let d=await r.json();if(!d.length)return;document.querySelectorAll(".store-name").forEach(e=>e.textContent=d[0].store_name||"الوسام للعطور");document.querySelectorAll(".tagline").forEach(e=>e.textContent=d[0].tagline||"أناقة تدوم... وعطر يميزك")}catch(e){console.error(e)}}
async function loadProducts(){let b=document.getElementById("products");b.innerHTML='<div class="empty">🧴 جاري تحميل المنتجات...</div>';try{let r=await fetch(`${API_CONFIG.url}/rest/v1/products?select=*,product_sizes(*)&active=eq.true&order=id.desc`,{headers});if(!r.ok)throw Error(await r.text());let d=await r.json();products=d.map(p=>({...p,sizes:p.product_sizes||[]}));renderProducts()}catch(e){console.error(e);b.innerHTML='<div class="empty">❌ تعذر تحميل المنتجات<br><small>راجع RLS وSupabase.</small></div>'}}
function renderProducts(){let b=document.getElementById("products");if(!products.length){b.innerHTML='<div class="empty">🧴 لا توجد منتجات حاليًا.<br><small>أضف أول منتج من لوحة التحكم.</small></div>';return}b.innerHTML=products.map(p=>{let s=p.sizes?.[0];return `<article class="card" data-cat="${esc(p.category)}"><img src="${esc(p.image||"assets/images/logo.jpg")}" alt="${esc(p.name)}"><div><small>${labels[p.category]||""}</small><h3>${esc(p.name)}</h3>${s?`<strong>${money(fp(s))}</strong>`:"<small>لا يوجد سعر</small>"}<button onclick='showProduct(${JSON.stringify(p).replace(/</g,"\\u003c")})'>عرض المنتج</button></div></article>`}).join("")}
function showProduct(p){current=p;qty=1;currentSize=p.sizes?.[0]||null;renderProduct();document.getElementById("modal").classList.add("show")}
function renderProduct(){document.getElementById("modalContent").innerHTML=`<div class="detail"><img src="${esc(current.image||"assets/images/logo.jpg")}" alt="${esc(current.name)}"><div><small>${labels[current.category]||""}</small><h2>${esc(current.name)}</h2><p>${esc(current.description||"")}</p><h3>اختر الحجم</h3><div class="sizes">${current.sizes?.length?current.sizes.map(s=>`<button class="${Number(currentSize?.id)===Number(s.id)?"sel":""}" onclick="pickSize(${s.id})">${s.size_ml}ml<br><b>${money(fp(s))}</b></button>`).join(""):"<p>لا توجد أحجام متاحة.</p>"}</div><div class="qty"><button onclick="qty=Math.max(1,qty-1);renderProduct()">−</button><b>${qty}</b><button onclick="qty++;renderProduct()">+</button></div><button class="gold full" onclick="add()" ${!currentSize?"disabled":""}>إضافة للسلة</button></div></div>`}
function pickSize(id){currentSize=current.sizes.find(s=>Number(s.id)===Number(id));renderProduct()}
function add(){if(!currentSize)return alert("من فضلك اختر الحجم أولًا");cart.push({product:{id:current.id,name:current.name,image:current.image},size:currentSize,qty});save();showCart()}
function save(){localStorage.setItem("wissam_cart",JSON.stringify(cart));let c=document.getElementById("cartCount");if(c)c.textContent=cart.reduce((a,x)=>a+Number(x.qty||0),0)}
function showCart(){let total=0;let rows=cart.map((x,i)=>{let t=fp(x.size)*Number(x.qty);total+=t;return `<div class="item"><div><b>${esc(x.product.name)}</b><br><small>${x.size.size_ml}ml × ${x.qty}</small></div><b>${money(t)}</b><button onclick="cart.splice(${i},1);save();showCart()">حذف</button></div>`}).join("");document.getElementById("modalContent").innerHTML=cart.length?`<h2>🛒 سلة المشتريات</h2>${rows}<h3 class="total">الإجمالي: ${money(total)}</h3><button class="gold full" onclick="checkout()">إتمام الطلب</button>`:"<h2>السلة فارغة</h2>";document.getElementById("modal").classList.add("show")}
function openCart(){showCart()}
function checkout(){document.getElementById("modalContent").innerHTML=`<h2>بيانات الطلب</h2><form onsubmit="sendOrder(event)"><input id="customerName" required placeholder="الاسم"><input id="customerPhone" required placeholder="رقم الموبايل"><textarea id="customerAddress" required placeholder="العنوان"></textarea><button class="gold full">تأكيد الطلب</button></form>`}
async function sendOrder(e){e.preventDefault();let name=document.getElementById("customerName").value.trim(),phone=document.getElementById("customerPhone").value.trim(),address=document.getElementById("customerAddress").value.trim(),total=cart.reduce((a,x)=>a+fp(x.size)*Number(x.qty),0);try{let r=await fetch(`${API_CONFIG.url}/rest/v1/orders`,{method:"POST",headers:{...headers,"Content-Type":"application/json","Prefer":"return=representation"},body:JSON.stringify({customer_name:name,phone,address,total,status:"pending"})});if(!r.ok)throw Error(await r.text());let order=(await r.json())[0];let items=cart.map(x=>{let original=Number(x.size.price||0),final=fp(x.size);return {order_id:order.id,product_id:x.product.id,product_name:x.product.name,size_ml:Number(x.size.size_ml),quantity:Number(x.qty),original_price:original,discount:original-final,final_price:final}});let ir=await fetch(`${API_CONFIG.url}/rest/v1/order_items`,{method:"POST",headers:{...headers,"Content-Type":"application/json"},body:JSON.stringify(items)});if(!ir.ok)throw Error(await ir.text());cart=[];save();document.getElementById("modalContent").innerHTML=`<div class="empty"><h2>✅ تم استلام طلبك</h2><p>رقم الطلب: <strong>#${order.id}</strong></p><button class="gold full" onclick="closeModal()">إغلاق</button></div>`}catch(err){alert("❌ فشل إرسال الطلب\n"+err.message)}}
function closeModal(){document.getElementById("modal").classList.remove("show")}
document.querySelectorAll(".cats button").forEach(b=>b.onclick=()=>{document.querySelectorAll(".cats button").forEach(x=>x.classList.remove("active"));b.classList.add("active");document.querySelectorAll(".card").forEach(c=>c.style.display=b.dataset.cat==="all"||b.dataset.cat===c.dataset.cat?"":"none")});
save();loadSettings();loadProducts();